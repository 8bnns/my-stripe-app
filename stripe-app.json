{
    "id": "com.mohamadalhabshan.my-stripe-app",
    "version": "0.0.1",
    "name": "My Stripe App",
    "icon": "./src/views/brand_icon.svg",
    "permissions": [],
    "ui_extension": {
        "views": [
            {
                "viewport": "stripe.dashboard.home.overview",
                "component": "Home"
            },
            {
                "viewport": "stripe.dashboard.customer.list",
                "component": "Customers"
            },
            {
                "viewport": "stripe.dashboard.customer.detail",
                "component": "CustomerDetails"
            }
        ],
        "content_security_policy": {
            "connect-src": null,
            "image-src": null,
            "purpose": "Allows external resources and image loading"
        }
    }
}